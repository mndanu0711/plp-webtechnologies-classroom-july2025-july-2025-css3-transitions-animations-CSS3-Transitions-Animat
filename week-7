<!DOCTYPE html>
<html>
<head>
  <title>CSS Transitions & Animations</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
    <h1>Functions Demo</h1>

  <button id="doubleBtn">Double Number</button>
  <button id="colorBtn">Change Box Color</button>

  <div id="box"></div>
  <p id="result"></p>

  <h2>CSS Transitions and Animations</h2>

  <!-- Button hover effect -->
  <button class="animated-btn">Hover Me</button>

  <!-- Smooth fade-in text -->
  <p class="fade-text">This text fades in when the page loads.</p>

  <!-- Sliding box -->
  <div class="slide-box"></div>

  <!-- Continuous animation -->
  <div class="spinner"></div>

</body>
</html>
